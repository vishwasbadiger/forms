<h2><span style='font-family:"Calibri",sans-serif;mso-fareast-font-family:"Times New Roman"'><!-- SCRIPTS -->6.
Scripts<o:p></o:p></span></h2>

<h3><span style='font-family:"Calibri",sans-serif;mso-fareast-font-family:"Times New Roman"'>6.1
&nbsp; remove-<span class=SpellE>andrew</span>-<span class=SpellE><span
class=GramE>folders.groovy</span></span> — Migration Script<o:p></o:p></span></h3>

<p><span style='font-size:11.0pt;font-family:"Calibri",sans-serif;color:#1A1A1A'>Run
via AEM Groovy Console. Set </span><span class=mono1><span style='font-size:
9.5pt;mso-bidi-font-family:Calibri;color:#1A1A1A'>DRY_RUN = true</span></span><span
style='font-size:11.0pt;font-family:"Calibri",sans-serif;color:#1A1A1A'> first
to preview all moves/deletes/ref-updates, then set to </span><span class=mono1><span
style='font-size:9.5pt;mso-bidi-font-family:Calibri;color:#1A1A1A'>false</span></span><span
style='font-size:11.0pt;font-family:"Calibri",sans-serif;color:#1A1A1A'> to
apply. Change </span><span class=mono1><span style='font-size:9.5pt;mso-bidi-font-family:
Calibri;color:#1A1A1A'>TARGET_BU</span></span><span style='font-size:11.0pt;
font-family:"Calibri",sans-serif;color:#1A1A1A'> for each BU.<o:p></o:p></span></p>

<p class=MsoNormal><span class=code-label1><span style='font-size:9.0pt;
font-family:"Calibri",sans-serif;mso-fareast-font-family:"Times New Roman"'>docs/remove-<span
class=SpellE>andrew</span>-<span class=SpellE>folders.groovy</span></span></span><span
style='font-size:11.0pt;font-family:"Calibri",sans-serif;mso-fareast-font-family:
"Times New Roman";color:#1A1A1A'> <o:p></o:p></span></p>

<div style='border:solid #4A5568 1.0pt;padding:12.0pt 12.0pt 12.0pt 12.0pt;
margin-top:10.0pt;margin-bottom:10.0pt'>

<p class=MsoNormal style='background:#1A202C;word-break:break-all'><span
style='font-size:8.5pt;font-family:Consolas;mso-fareast-font-family:"Times New Roman";
mso-bidi-font-family:Calibri;color:#E2E8F0'>import <span class=SpellE><span
class=GramE>javax.jcr.Node</span></span> import <span class=SpellE><span
class=GramE>javax.jcr.Session</span></span> //
─────────────────────────────────────────────────────────────────────────────
// Remove &quot;<span class=SpellE>andrew</span>&quot; folder hierarchy — JIRA
 // // Scans BOTH storage trees: // /content/forms/<span class=SpellE>af</span>/<span
class=SpellE>spglobal</span>/ — AEM Forms Manager tree // /content/dam/<span
class=SpellE>formsanddocuments</span>/<span class=SpellE>spglobal</span>/ — DAM
tree (what pages reference) // // Steps: // 1. Discover forms inside *<span
class=SpellE>andrew</span>* folders // 2. Move each form to the BU root level
// 3. Delete <span class=GramE>now-empty</span> <span class=SpellE>andrew</span>
folders // 4. Update <span class=SpellE>formRef</span> / <span class=SpellE>formPath</span>
/ etc. on pages (DAM paths only) // // Run with DRY_RUN = true first, read the
discovery output, then flip <span class=GramE>to</span> false. //
─────────────────────────────────────────────────────────────────────────────
def DRY_RUN = true // ← set to false to apply // Set to one of:
&quot;corporate&quot; | &quot;mi&quot; | &quot;ratings&quot; |
&quot;energy&quot; | &quot;sustainable1&quot; | &quot;all&quot; def TARGET_BU =
&quot;energy&quot; def ALL_BUS = [&quot;corporate&quot;, &quot;mi&quot;,
&quot;ratings&quot;, &quot;energy&quot;, &quot;sustainable1&quot;] def
ACTIVE_BUS = TARGET_BU == &quot;all<span class=GramE>&quot; ?</span> ALL_<span
class=GramE>BUS :</span> [TARGET_BU] def AF_BU_ROOTS = <span class=SpellE>ACTIVE_BUS.collect</span>
<span class=GramE>{ &quot;</span>/content/forms/<span class=SpellE>af</span>/<span
class=SpellE>spglobal</span>/${it}<span class=GramE>&quot; }</span> def
DAM_BU_ROOTS = <span class=SpellE>ACTIVE_BUS.collect</span> <span class=GramE>{
&quot;</span>/content/dam/<span class=SpellE>formsanddocuments</span>/<span
class=SpellE>spglobal</span>/${it}<span class=GramE>&quot; }</span> def
REF_SEARCH_ROOT = (TARGET_BU == &quot;all&quot;<span class=GramE>) ?</span>
&quot;/content/<span class=SpellE>spglobal</span>&quot; : &quot;/content/<span
class=SpellE>spglobal</span>/${TARGET_BU}&quot; def FORM_MOVES = [:] as <span
class=SpellE>LinkedHashMap</span> def ANDREW_FOLDERS = [] as <span
class=SpellE>LinkedHashSet</span> def <span class=SpellE>findAndrewForms</span>
<span class=SpellE>findAndrewForms</span> = { Node <span class=SpellE>parentNode</span>,
int depth, String <span class=SpellE>buRoot</span> -&gt; if (depth &gt; 8)
return <span class=SpellE>parentNode.nodes.each</span> { Node child -&gt; if (<span
class=SpellE>child.name.toLowerCase</span>().contains(&quot;<span class=SpellE>andrew</span>&quot;))
{ def <span class=SpellE>realChildren</span> = [] <span class=SpellE>child.nodes.each</span>
{ Node <span class=SpellE>gc</span> -&gt; if (gc.name != &quot;<span
class=SpellE>jcr:content</span>&quot;) <span class=SpellE>realChildren</span>
&lt;&lt; <span class=SpellE>gc</span> } if (<span class=SpellE>realChildren</span>)
{ ANDREW_FOLDERS &lt;&lt; <span class=SpellE>child.path</span> <span
class=SpellE>realChildren.each</span> { Node form -&gt; FORM_MOVES[<span
class=SpellE>form.path</span>] = <span class=SpellE>buRoot</span> +
&quot;/&quot; + form.name } } else { FORM_MOVES[<span class=SpellE>child.path</span>]
= <span class=SpellE>buRoot</span> + &quot;/&quot; + child.name } } else { <span
class=SpellE>findAndrewForms</span>(child, depth + 1, <span class=SpellE>buRoot</span>)
} } } <span class=SpellE>println</span> &quot;=== DISCOVERY ===\n&quot; (AF_BU_ROOTS
+ DAM_BU_ROOTS).each { <span class=SpellE>buRoot</span> -&gt; if (!<span
class=SpellE>session.nodeExists</span>(<span class=SpellE>buRoot</span>)) { <span
class=SpellE>println</span> &quot; NOT FOUND — skipping: ${<span class=SpellE>buRoot</span>}&quot;;
return } <span class=SpellE>findAndrewForms</span>(<span class=SpellE>session.getNode</span>(<span
class=SpellE>buRoot</span>), 0, <span class=SpellE>buRoot</span>) } if (<span
class=SpellE>FORM_MOVES.isEmpty</span>()) { <span class=SpellE>println</span>
&quot; No <span class=SpellE>andrew</span> forms found — nothing to do.&quot;;
return } <span class=SpellE>println</span> &quot; Andrew folders : ${<span
class=SpellE>ANDREW_FOLDERS.size</span>()}&quot; <span class=SpellE>ANDREW_FOLDERS.each</span>
{ <span class=SpellE>println</span> &quot; ${it}&quot; } <span class=SpellE>println</span>
&quot;\n Forms to move : ${<span class=SpellE>FORM_MOVES.size</span>()}&quot; <span
class=SpellE>FORM_MOVES.each</span> { <span class=SpellE>src</span>, <span
class=SpellE>dst</span> -&gt; <span class=SpellE>println</span> &quot; ${<span
class=SpellE>src</span>}\n → ${<span class=SpellE>dst</span>}&quot; } def line
= { <span class=SpellE>println</span> &quot;\n&quot; + (&quot;─&quot; * 72) +
&quot;\n&quot; } line() <span class=SpellE>println</span> DRY_RUN ? &quot; </span><span
style='font-size:8.5pt;font-family:"Segoe UI Symbol",sans-serif;mso-fareast-font-family:
"Times New Roman";mso-bidi-font-family:"Segoe UI Symbol";color:#E2E8F0'>⚠</span><span
style='font-size:8.5pt;font-family:Consolas;mso-fareast-font-family:"Times New Roman";
mso-bidi-font-family:Calibri;color:#E2E8F0'> DRY RUN — nothing will be
saved&quot; : &quot; </span><span style='font-size:8.5pt;font-family:"Segoe UI Symbol",sans-serif;
mso-fareast-font-family:"Times New Roman";mso-bidi-font-family:"Segoe UI Symbol";
color:#E2E8F0'>✔</span><span style='font-size:8.5pt;font-family:Consolas;
mso-fareast-font-family:"Times New Roman";mso-bidi-font-family:Calibri;
color:#E2E8F0'> LIVE RUN — changes WILL be written&quot; line() def moved = 0,
skipped = 0, <span class=SpellE>notFound</span> = 0 // STEP 1: Move forms <span
class=SpellE>println</span> &quot;[STEP 1] Moving forms\n&quot; <span
class=SpellE>FORM_MOVES.each</span> { <span class=SpellE>src</span>, <span
class=SpellE>dst</span> -&gt; if (!<span class=SpellE>session.nodeExists</span>(<span
class=SpellE>src</span>)) { <span class=SpellE>println</span> &quot; NOT FOUND
: ${<span class=SpellE>src</span>}&quot;; <span class=SpellE>notFound</span>++;
return } if (<span class=SpellE>session.nodeExists</span>(<span class=SpellE>dst</span>))
{ <span class=SpellE>println</span> &quot; DEST EXISTS: ${<span class=SpellE>src</span>}\n
→ ${<span class=SpellE>dst</span>}&quot;; skipped++; return } if (!DRY_RUN) <span
class=SpellE>session.move</span>(<span class=SpellE>src</span>, <span
class=SpellE>dst</span>) <span class=SpellE>println</span> &quot; ${DRY_RUN ?
'[DRY] MOVE ' : 'MOVED '}: ${<span class=SpellE>src</span>}\n → ${<span
class=SpellE>dst</span>}&quot; moved++ } if (!DRY_RUN &amp;&amp; moved &gt; 0)
{ <span class=SpellE>session.save</span>(); <span class=SpellE>println</span>
&quot;\n Saved — ${moved} move(s) applied&quot; } // STEP 2: Delete empty <span
class=SpellE>andrew</span> folders line() <span class=SpellE>println</span>
&quot;[STEP 2] Deleting empty <span class=SpellE>andrew</span> folders\n&quot;
def deleted = 0 <span class=SpellE>ANDREW_FOLDERS.each</span> { <span
class=SpellE>folderPath</span> -&gt; if (!<span class=SpellE>session.nodeExists</span>(<span
class=SpellE>folderPath</span>)) { <span class=SpellE>println</span> &quot; NOT
FOUND : ${<span class=SpellE>folderPath</span>}&quot;; return } def folder = <span
class=SpellE>session.getNode</span>(<span class=SpellE>folderPath</span>) def
remaining = []; <span class=SpellE>folder.nodes.each</span> { child -&gt; if
(child.name != &quot;<span class=SpellE>jcr:content</span>&quot;) remaining
&lt;&lt; child.name } if (remaining) { <span class=SpellE>println</span> &quot;
NOT EMPTY : ${<span class=SpellE>folderPath</span>} (${<span class=SpellE>remaining.join</span>(',
')})&quot;; return } if (!DRY_RUN) <span class=SpellE>folder.remove</span>() <span
class=SpellE>println</span> &quot; ${DRY_RUN ? '[DRY] DELETE' : 'DELETED '}: ${<span
class=SpellE>folderPath</span>}&quot; deleted++ } if (!DRY_RUN &amp;&amp;
deleted &gt; 0) { <span class=SpellE>session.save</span>(); <span class=SpellE>println</span>
&quot;\n Saved — ${deleted} folder(s) removed&quot; } // STEP 3: Update content
references line() <span class=SpellE>println</span> &quot;[STEP 3] Updating
content references under ${REF_SEARCH_ROOT}\n&quot; def updated = 0 def
DAM_MOVES = <span class=SpellE>FORM_MOVES.findAll</span> { <span class=SpellE>src</span>,
<span class=SpellE>dst</span> -&gt; <span class=SpellE>src.startsWith</span>(&quot;/content/dam/&quot;)
} def REF_PROPS = [&quot;<span class=SpellE>formRef</span>&quot;, &quot;<span
class=SpellE>formPath</span>&quot;, &quot;<span class=SpellE>guideContainerPath</span>&quot;,
&quot;<span class=SpellE>fileReference</span>&quot;] def walk <span
class=SpellE>walk</span> = { Node <span class=SpellE>node</span>, int depth
-&gt; if (depth &gt; 20) return try { <span class=SpellE>REF_PROPS.each</span>
{ prop -&gt; try { if (<span class=SpellE>node.hasProperty</span>(prop)) { def <span
class=SpellE>val</span> = <span class=SpellE>node.getProperty</span>(prop).<span
class=SpellE>getString</span>() if (<span class=SpellE>DAM_MOVES.containsKey</span>(<span
class=SpellE>val</span>)) { def <span class=SpellE>newPath</span> = DAM_MOVES[<span
class=SpellE>val</span>] if (!DRY_RUN) <span class=SpellE>node.setProperty</span>(prop,
<span class=SpellE>newPath</span>) <span class=SpellE>println</span> &quot;
${DRY_RUN ? '[DRY] UPDATE' : 'UPDATED '} [${prop}] @ ${<span class=SpellE>node.path</span>}&quot;
<span class=SpellE>println</span> &quot; ${<span class=SpellE>val</span>}\n →
${<span class=SpellE>newPath</span>}&quot; updated++ } } } catch (Exception
ignored) {} } <span class=SpellE>node.nodes.each</span> { child -&gt;
walk(child, depth + 1) } } catch (Exception ignored) {} } if (<span
class=SpellE>session.nodeExists</span>(REF_SEARCH_ROOT)) { <span class=SpellE>println</span>
&quot; Walking ${REF_SEARCH_ROOT} — may take 30–60s...\n&quot; walk(<span
class=SpellE>session.getNode</span>(REF_SEARCH_ROOT), 0) } else { <span
class=SpellE>println</span> &quot; SEARCH ROOT NOT FOUND:
${REF_SEARCH_ROOT}&quot; } if (!DRY_RUN &amp;&amp; updated &gt; 0) { <span
class=SpellE>session.save</span>(); <span class=SpellE>println</span> &quot;\n
Saved — ${updated} reference(s) updated&quot; } line() <span class=SpellE>println</span>
&quot;SUMMARY&quot; <span class=SpellE>println</span> &quot; Forms moved :
${moved}&quot; <span class=SpellE>println</span> &quot; Forms not found : ${<span
class=SpellE>notFound</span>}&quot; <span class=SpellE>println</span> &quot;
Destination already exists : ${skipped}&quot; <span class=SpellE>println</span>
&quot; Andrew folders deleted : ${deleted}&quot; <span class=SpellE>println</span>
&quot; Content refs updated : ${updated}&quot; if (DRY_RUN) <span class=SpellE>println</span>
&quot;\n </span><span style='font-size:8.5pt;font-family:"Segoe UI Symbol",sans-serif;
mso-fareast-font-family:"Times New Roman";mso-bidi-font-family:"Segoe UI Symbol";
color:#E2E8F0'>⚠</span><span style='font-size:8.5pt;font-family:Consolas;
mso-fareast-font-family:"Times New Roman";mso-bidi-font-family:Calibri;
color:#E2E8F0'> DRY RUN complete — set DRY_RUN = false to apply&quot; line()<o:p></o:p></span></p>

</div>

<h3><span style='font-family:"Calibri",sans-serif;mso-fareast-font-family:"Times New Roman"'>6.2
&nbsp; validate-<span class=SpellE>andrew</span>-<span class=SpellE><span
class=GramE>migration.groovy</span></span> — QA Validation Script<o:p></o:p></span></h3>

<p><span style='font-size:11.0pt;font-family:"Calibri",sans-serif;color:#1A1A1A'>Read-only
script. No changes are made. Run after migration to confirm clean state. Prints
<strong><span style='font-family:"Calibri",sans-serif'>PASS / FAIL</span></strong>
summary with exact paths for any failures.<o:p></o:p></span></p>

<p class=MsoNormal><span class=code-label1><span style='font-size:9.0pt;
font-family:"Calibri",sans-serif;mso-fareast-font-family:"Times New Roman"'>docs/validate-<span
class=SpellE>andrew</span>-<span class=SpellE>migration.groovy</span></span></span><span
style='font-size:11.0pt;font-family:"Calibri",sans-serif;mso-fareast-font-family:
"Times New Roman";color:#1A1A1A'> <o:p></o:p></span></p>

<div style='border:solid #4A5568 1.0pt;padding:12.0pt 12.0pt 12.0pt 12.0pt;
margin-top:10.0pt;margin-bottom:10.0pt'>

<p class=MsoNormal style='background:#1A202C;word-break:break-all'><span
style='font-size:8.5pt;font-family:Consolas;mso-fareast-font-family:"Times New Roman";
mso-bidi-font-family:Calibri;color:#E2E8F0'>import <span class=SpellE><span
class=GramE>javax.jcr.Node</span></span> //
─────────────────────────────────────────────────────────────────────────────
// QA Validation — post <span class=SpellE>andrew</span>-folder migration //
READ-ONLY — no changes made to the repository. //
─────────────────────────────────────────────────────────────────────────────
def TARGET_BU = &quot;energy&quot; //
&quot;corporate&quot;|&quot;mi&quot;|&quot;ratings&quot;|&quot;energy&quot;|&quot;sustainable1&quot;|&quot;all&quot;
def ALL_BUS = [&quot;corporate&quot;, &quot;mi&quot;, &quot;ratings&quot;,
&quot;energy&quot;, &quot;sustainable1&quot;] def ACTIVE_BUS = TARGET_BU ==
&quot;all<span class=GramE>&quot; ?</span> ALL_<span class=GramE>BUS :</span>
[TARGET_BU] def AF_BU_ROOTS = <span class=SpellE>ACTIVE_BUS.collect</span> <span
class=GramE>{ &quot;</span>/content/forms/<span class=SpellE>af</span>/<span
class=SpellE>spglobal</span>/${it}<span class=GramE>&quot; }</span> def
DAM_BU_ROOTS = <span class=SpellE>ACTIVE_BUS.collect</span> <span class=GramE>{
&quot;</span>/content/dam/<span class=SpellE>formsanddocuments</span>/<span
class=SpellE>spglobal</span>/${it}<span class=GramE>&quot; }</span> def
REF_SEARCH_ROOT = TARGET_BU == &quot;all<span class=GramE>&quot; ?</span>
&quot;/content/<span class=SpellE>spglobal</span>&quot; : &quot;/content/<span
class=SpellE>spglobal</span>/${TARGET_BU}&quot; def REF_PROPS = [&quot;<span
class=SpellE>formRef</span>&quot;, &quot;<span class=SpellE>formPath</span>&quot;,
&quot;<span class=SpellE>guideContainerPath</span>&quot;, &quot;<span
class=SpellE>fileReference</span>&quot;] def <span class=SpellE>andrewNodes</span>
= [] def <span class=SpellE>staleRefs</span> = [] def line = { <span
class=SpellE>println</span> &quot;\n&quot; + (&quot;─&quot; * 72) +
&quot;\n&quot; } // STEP 1: Check for surviving <span class=SpellE>andrew</span>
nodes line() <span class=SpellE>println</span> &quot;[STEP 1] Scanning for
remaining <span class=SpellE>andrew</span> nodes\n&quot; def <span
class=SpellE>findAndrew</span> <span class=SpellE>findAndrew</span> = { Node n,
int depth -&gt; if (depth &gt; 8) return try { <span class=SpellE>n.nodes.each</span>
{ Node child -&gt; if (<span class=SpellE>child.name.toLowerCase</span>().contains(&quot;<span
class=SpellE>andrew</span>&quot;)) { <span class=SpellE>andrewNodes</span>
&lt;&lt; <span class=SpellE>child.path</span> <span class=SpellE>println</span>
&quot; STILL EXISTS: ${<span class=SpellE>child.path</span>}&quot; } else { <span
class=SpellE>findAndrew</span>(child, depth + 1) } } } catch (Exception
ignored) {} } (AF_BU_ROOTS + DAM_BU_ROOTS).each { root -&gt; if (!<span
class=SpellE>session.nodeExists</span>(root)) { <span class=SpellE>println</span>
&quot; NOT FOUND — skipping: ${root}&quot;; return } <span class=SpellE>findAndrew</span>(<span
class=SpellE>session.getNode</span>(root), 0) } if (<span class=SpellE>andrewNodes.isEmpty</span>())
<span class=SpellE>println</span> &quot; </span><span style='font-size:8.5pt;
font-family:"Segoe UI Symbol",sans-serif;mso-fareast-font-family:"Times New Roman";
mso-bidi-font-family:"Segoe UI Symbol";color:#E2E8F0'>✓</span><span
style='font-size:8.5pt;font-family:Consolas;mso-fareast-font-family:"Times New Roman";
mso-bidi-font-family:Calibri;color:#E2E8F0'> No <span class=SpellE>andrew</span>
nodes found&quot; // STEP 2: Scan page tree for stale refs line() <span
class=SpellE>println</span> &quot;[STEP 2] Scanning page refs under
${REF_SEARCH_ROOT}\n&quot; def walk <span class=SpellE>walk</span> = { Node <span
class=SpellE>node</span>, int depth -&gt; if (depth &gt; 20) return try { <span
class=SpellE>REF_PROPS.each</span> { prop -&gt; try { if (<span class=SpellE>node.hasProperty</span>(prop))
{ def <span class=SpellE>val</span> = <span class=SpellE>node.getProperty</span>(prop).<span
class=SpellE>getString</span>() if (!<span class=SpellE>val</span> || !<span
class=SpellE>val.startsWith</span>(&quot;/&quot;)) return if (<span
class=SpellE>val.toLowerCase</span>().contains(&quot;<span class=SpellE>andrew</span>&quot;)
&amp;&amp; (<span class=SpellE>val.startsWith</span>(&quot;/content/forms/<span
class=SpellE>af</span>/&quot;) || <span class=SpellE>val.startsWith</span>(&quot;/content/dam/<span
class=SpellE>formsanddocuments</span>/&quot;))) { <span class=SpellE>staleRefs</span>
&lt;&lt; [<span class=SpellE>nodePath</span>: <span class=SpellE>node.path</span>,
prop: prop, <span class=SpellE>val</span>: <span class=SpellE>val</span>] <span
class=SpellE>println</span> &quot; STALE [${prop}] ${<span class=SpellE>node.path</span>}\n
→ ${<span class=SpellE>val</span>}&quot; } } } catch (Exception ignored) {} } <span
class=SpellE>node.nodes.each</span> { child -&gt; walk(child, depth + 1) } }
catch (Exception ignored) {} } if (<span class=SpellE>session.nodeExists</span>(REF_SEARCH_ROOT))
walk(<span class=SpellE>session.getNode</span>(REF_SEARCH_ROOT), 0) if (<span
class=SpellE>staleRefs.isEmpty</span>()) <span class=SpellE>println</span>
&quot; </span><span style='font-size:8.5pt;font-family:"Segoe UI Symbol",sans-serif;
mso-fareast-font-family:"Times New Roman";mso-bidi-font-family:"Segoe UI Symbol";
color:#E2E8F0'>✓</span><span style='font-size:8.5pt;font-family:Consolas;
mso-fareast-font-family:"Times New Roman";mso-bidi-font-family:Calibri;
color:#E2E8F0'> No stale refs found&quot; // Summary line() <span class=SpellE>println</span>
&quot;QA VALIDATION SUMMARY (BU: ${TARGET_BU})\n&quot; <span class=SpellE>println</span>
&quot; Andrew nodes still in repo : ${<span class=SpellE>andrewNodes.size</span>()}&quot;
<span class=SpellE>println</span> &quot; Stale refs (→ <span class=SpellE>andrew</span>
path) : ${<span class=SpellE>staleRefs.size</span>()}&quot; if (<span
class=SpellE>andrewNodes.isEmpty</span>() &amp;&amp; <span class=SpellE>staleRefs.isEmpty</span>())
{ <span class=SpellE>println</span> &quot;\n </span><span style='font-size:
8.5pt;font-family:"Segoe UI Symbol",sans-serif;mso-fareast-font-family:"Times New Roman";
mso-bidi-font-family:"Segoe UI Symbol";color:#E2E8F0'>✓</span><span
style='font-size:8.5pt;font-family:Consolas;mso-fareast-font-family:"Times New Roman";
mso-bidi-font-family:Calibri;color:#E2E8F0'> PASS — migration complete for
'${TARGET_BU}'&quot; } else { <span class=SpellE>println</span> &quot;\n </span><span
style='font-size:8.5pt;font-family:"Segoe UI Symbol",sans-serif;mso-fareast-font-family:
"Times New Roman";mso-bidi-font-family:"Segoe UI Symbol";color:#E2E8F0'>✗</span><span
style='font-size:8.5pt;font-family:Consolas;mso-fareast-font-family:"Times New Roman";
mso-bidi-font-family:Calibri;color:#E2E8F0'> FAIL — issues need attention&quot;
if (!<span class=SpellE>staleRefs.isEmpty</span>()) { <span class=SpellE>println</span>
&quot;\n Stale refs to fix:&quot; <span class=SpellE>staleRefs.each</span> { r
-&gt; <span class=SpellE>println</span> &quot; [${<span class=SpellE>r.prop</span>}]
${<span class=SpellE>r.nodePath</span>} → ${<span class=SpellE>r.val</span>}&quot;
} } } line()<o:p></o:p></span></p>

</div>

